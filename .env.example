# Environment variables (names only — never real secrets)

# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local
# local | e2e | staging | production
APP_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://clinic:clinic@127.0.0.1:54329/clinic

# ─── Session / crypto ──────────────────────────────────────────────────────
AUTH_SECRET=replace-with-32-plus-byte-random

# Dev only — never in production
AUTH_DEV_LOG_OTP=false

# ─── E2E / test (NEVER enable in production) ───────────────────────────────
E2E=false
ENABLE_TEST_OTP_ENDPOINT=false
EMAIL_CAPTURE=false

# ─── Email ─────────────────────────────────────────────────────────────────
# local: console | e2e: memory | staging/production: smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_FROM=noreply@localhost

# ─── Object storage ────────────────────────────────────────────────────────
OBJECT_STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PUBLIC_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ─── Observability ─────────────────────────────────────────────────────────
OPS_READINESS_TOKEN=
ERROR_TRACKING_DSN=

# ─── Production policy ─────────────────────────────────────────────────────
DISABLE_DESIGN_PREVIEW=false

# ─── Bootstrap (one-time CLI only) ───────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_CONFIRM=

# ─── Embedded PostgreSQL (local dev only) ────────────────────────────────────
EMBEDDED_PG_PORT=54329
