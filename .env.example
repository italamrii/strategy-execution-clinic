# Environment variables (names only — never real secrets)

# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local
# local | e2e | staging | production
APP_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://clinic:clinic@127.0.0.1:54329/clinic

# ─── Authentication ────────────────────────────────────────────────────────
# clerk = Clerk-managed email OTP (production). legacy = local OTP (tests/dev only).
AUTH_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only — never prefix with NEXT_PUBLIC_ and never commit the value
CLERK_SECRET_KEY=

# Optional Clerk route hints (custom login lives at /[locale]/login)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/ar/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/ar/login

# Still used for legacy OTP hashing / non-Clerk crypto in legacy mode
AUTH_SECRET=replace-with-32-plus-byte-random

# Dev only — never in production
AUTH_DEV_LOG_OTP=false

# ─── E2E / test (NEVER enable in production) ───────────────────────────────
E2E=false
ENABLE_TEST_OTP_ENDPOINT=false
EMAIL_CAPTURE=false

# ─── Email (notifications / non-auth mail) ─────────────────────────────────
# Auth OTPs are sent by Clerk when AUTH_PROVIDER=clerk — SMTP is not required for login.
# local: console | e2e: memory | optional smtp for notification delivery
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_FROM=noreply@localhost

# ─── Object storage ────────────────────────────────────────────────────────
OBJECT_STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PUBLIC_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ─── Audio / video meetings ────────────────────────────────────────────────
# Private consultation rooms require a dedicated HTTPS Jitsi host with JWT
# token authentication. Public meet.jit.si is not access-controlled: anyone
# with the room URL can join. The rest of the platform does not require a
# Jitsi host. Live entry stays disabled until BOTH private JWT configuration
# and JITSI_OPERATOR_VERIFIED=YES are set.
#
# Set the flag only after you have tested the real host:
#   - a valid room-scoped token succeeds
#   - missing, invalid, expired, and wrong-room tokens fail
#   - opening the room URL directly cannot bypass authentication
# The in-app host probe is a connectivity/configuration diagnostic, not a
# security attestation. HTTP 401/403, item-not-found, and policy-violation
# do not prove JWT enforcement.
JITSI_DOMAIN=
JITSI_JWT_APP_ID=
JITSI_JWT_SECRET=
JITSI_JWT_ISSUER=
JITSI_OPERATOR_VERIFIED=

# ─── Observability ─────────────────────────────────────────────────────────
OPS_READINESS_TOKEN=
ERROR_TRACKING_DSN=

# ─── Production policy ─────────────────────────────────────────────────────
DISABLE_DESIGN_PREVIEW=false

# ─── Bootstrap (one-time CLI only) ───────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_CONFIRM=

# ─── Embedded PostgreSQL (local dev only) ────────────────────────────────────
EMBEDDED_PG_PORT=54329
